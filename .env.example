AK2API_CONTAINER_NAME=ak2api
AK2API_PORT=8795
TZ=Asia/Taipei

AK_API_KEY=sk-replace-with-api-key
AK_ADMIN_TOKEN=replace-with-admin-token
AK_SYNC_TOKEN=replace-with-account-sync-token
AK_DATA_DIR=/app/data
AK_DATABASE_PATH=/app/data/ak2api.db

AK_TASK_WORKERS=10
AK_TASK_QUEUE_CAPACITY=100
AK_POLL_INTERVAL_SECONDS=10
AK_TASK_TIMEOUT_SECONDS=1800
AK_SYNCHRONOUS_TIMEOUT_SECONDS=900
AK_REQUEST_TIMEOUT_SECONDS=90
AK_REQUEST_RETRIES=2
AK_ACCOUNT_MAINTENANCE_INTERVAL_SECONDS=300
AK_ACCOUNT_MAINTENANCE_WORKERS=3
AK_ACCOUNT_DEFAULT_CONCURRENCY=8

AK_MEDIA_TIMEOUT_SECONDS=180
AK_MEDIA_MAX_BYTES=104857600
AK_MEDIA_FALLBACK_PROXY_URL=http://127.0.0.1:10809

AK_BROWSER_RECOVERY_ENABLED=true
AK_BROWSER_TIMEOUT_SECONDS=180
AK_BROWSER_LOGIN_WORKERS=2
AK_CHROME_EXECUTABLE=
AK_CHROME_USER_DATA_ROOT=data/ak-chrome-profiles
AK_CHROME_CDP_BASE_PORT=19800
AK_CHROME_HEADLESS=false

AK_PROXY_HOST_OVERRIDE=
AK_PROXY_POOL_ENABLED=true
# Comma-separated. Docker peers can use xray:20001 directly.
AK_PROXY_POOL=

AK_LOW_BALANCE_DISABLE_THRESHOLD=1
AK_EXCESS_MEDIA_POLICY=ignore
AK_PROMPT_MEDIA_REFERENCE_CLEANUP_ENABLED=false
AK_MODEL_MAP={"seedance-2.0-mini":"doubao-seedance-2-0-mini-260615","seedance-2.0-fast":"doubao-seedance-2-0-fast-260128","seedance-2.0":"doubao-seedance-2-0-260128","seedance-2.5":"doubao-seedance-2-5","minimax-h3":"minimax-h3"}
AK_SCHEMA_VERSION=1.0.0
